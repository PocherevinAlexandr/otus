Vagrant.configure("2") do |config|

  # 1. СЕРВЕР 
  config.vm.define "pxeserver" do |server|
    server.vm.box = "bentoubuntu-24.04"
    server.vm.host_name = "pxeserver"
    server.vm.boot_timeout = 300
    # Внутренняя сеть
    server.vm.network "private_network", ip: "192.168.56.10", virtualbox__intnet: "pxe_net"
    
    server.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
    end

    # Запуск Ansible
    server.vm.provision "ansible" do |ansible|
      ansible.playbook = "playbook.yml"
    end
  end

  # 2. КЛИЕНТ
  config.vm.define "pxeclient" do |client|
    client.vm.box = "bentoubuntu-24.04"
    client.vm.boot_timeout = 5 

    client.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 1
      vb.customize ["modifyvm", :id, "--boot1", "net", "--boot2", "none"]
#     vb.customize ["modifyvm", :id, "--firmware", "efi"]
      vb.customize ["modifyvm", :id, "--nic1", "intnet", "--intnet1", "pxe_net"]
    end

    client.vm.synced_folder ".", "/vagrant", disabled: true
  end

end
