Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/focal64"

  # 1. СЕРВЕР WEB (Клиент)
  config.vm.define "web" do |web|
    web.vm.hostname = "web-server"
    web.vm.network "private_network", ip: "192.168.56.10"
    web.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
    end
  end

  # 2. СЕРВЕР LOG (Центральный сервер + Запуск Ansible)
  config.vm.define "log" do |log|
    log.vm.hostname = "log-server"
    log.vm.network "private_network", ip: "192.168.56.15"
    log.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
    end

    # Запуск Ansible внутри этой же виртуалки log
    log.vm.provision "ansible_local" do |ansible|
      ansible.playbook = "playbook.yml"
      ansible.install = true # Vagrant сам установит Ansible в Ubuntu
      ansible.limit = "all"
    end
  end
end
