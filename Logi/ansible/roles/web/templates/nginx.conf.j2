user www-data;
worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 768;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Логи доступа летят ТОЛЬКО на удаленный сервер
    access_log syslog:server=192.168.56.15:514,facility=local7,tag=nginx_access,severity=info;

    # Логи ошибок: локально crit+, удаленно — всё начиная с info
    error_log /var/log/nginx/error.log crit;
    error_log syslog:server=192.168.56.15:514,facility=local7,tag=nginx_error info;

    sendfile on;
    keepalive_timeout 65;
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
