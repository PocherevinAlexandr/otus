Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  # Сервер резервных копий
  config.vm.define "backup" do |backup|
    backup.vm.hostname = "backup"
    backup.vm.network "private_network", ip: "192.168.56.160"
    backup.vm.disk :disk, name: "backup_disk", size: "2GB"

    backup.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
    end
  end

  # Клиент
  config.vm.define "client" do |client|
    client.vm.hostname = "client"
    client.vm.network "private_network", ip: "192.168.56.150"

    client.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
    end
  end

  # ГЛОБАЛЬНЫЙ ANSIBLE (выполняется после создания обеих машин)
  config.vm.provision "ansible" do |ansible|
    ansible.playbook = "playbook.yml"
    ansible.compatibility_mode = "2.0"
    # Создаем группы для плейбука на основе имен машин Vagrant
    ansible.groups = {
      "backup_servers" => ["backup"],
      "client_servers" => ["client"]
    }
  end
end
