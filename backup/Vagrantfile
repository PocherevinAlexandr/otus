# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  # Сервер резервных копий
  config.vm.define "backup" do |backup|
    backup.vm.hostname = "backup"
    backup.vm.network "private_network", ip: "192.168.11.160"
    
    backup.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
      disk_path = File.join(Dir.pwd, 'backup_disk.vdi')
      unless File.exist?(disk_path)
        v.customize ["createmedium", "disk", "--filename", disk_path, "--size", 2048]
      end
      v.customize ["storageattach", :id, "--storagectl", "SCSI", "--port", 1, "--device", 0, "--type", "hdd", "--medium", disk_path]
    end
  end

  # Клиент
  config.vm.define "client" do |client|
    client.vm.hostname = "client"
    client.vm.network "private_network", ip: "192.168.11.150"
    
    client.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
    end
    
    client.vm.provision "ansible" do |ansible|
      ansible.playbook = "playbook.yml"
      ansible.compatibility_mode = "2.0"
    end
  end
end
