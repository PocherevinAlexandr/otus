Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  config.vm.hostname = "pam-server"
  config.vm.boot_timeout = 600
  
  config.vm.network "private_network", ip: "192.168.57.10"
  config.vm.synced_folder ".", "/vagrant", disabled: false

  config.vm.provider "virtualbox" do |vb|
    vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
    vb.customize ["modifyvm", :id, "--accelerate3d", "off"]
    vb.customize ["modifyvm", :id, "--vram", "32"]
    vb.memory = "2048"
    vb.cpus = 1
    vb.gui = true
  end

  # 1. БЛОК: Установка SSL-сертификата, настройка DNS, SSH и установка Ansible + Passlib
  config.vm.provision "shell", inline: <<-SHELL
    set -e

  #  echo "=== 1. Интеграция корпоративного SSL-сертификата ==="
  #  if [ -f /vagrant/root_ca_2025.crt ]; then
  #    sudo cp /vagrant/root_ca_2025.crt /usr/local/share/ca-certificates/root_ca_2025.crt
  #    sudo update-ca-certificates
  #    echo "Сертификат успешно добавлен в доверенные!"
  #  else
  #    echo "ВНИМАНИЕ: Файл /vagrant/root_ca_2025.crt не найден. Проверьте имя файла."
  #  fi

   # echo "=== 2. Настройка DNS-серверов ==="
   # sudo rm -f /etc/resolv.conf
   # echo "nameserver *.*.*.*" | sudo tee /etc/resolv.conf
   # echo "nameserver *.*.*.*" | sudo tee -a /etc/resolv.conf

    echo "=== 3. Конфигурация SSH для авторизации по паролю ==="
    sed -i 's/^PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
    if [ -d /etc/ssh/sshd_config.d ]; then
      sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/g' /etc/ssh/sshd_config.d/*.conf 2>/dev/null || true
    fi
    systemctl restart sshd.service

    echo "=== 4. Обновление и чистая установка Ansible и Passlib ==="
    sudo apt-get update -y
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y ansible python3-passlib
  SHELL
  
  # 2. БЛОК: Запуск локального Ansible-плейбука 
  config.vm.provision "ansible_local" do |ansible|
    ansible.playbook = "playbook.yml"
    ansible.compatibility_mode = "2.0"
    ansible.install = false
  end
end
